.concept-card,.metric-card{border:1px solid #e4e7ec;border-radius:8px;padding:11px;background:#fff;margin-bottom:8px}.concept-card h4,.metric-card h4{margin:0;color:#23395d;font-size:13px}.concept-card p,.metric-card p{margin:5px 0;font-size:11px}.field-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:7px}.tag{display:inline-flex;background:#eef5ff;color:#0b3d91;border:1px solid #c7d8f2;border-radius:999px;padding:3px 6px;font-size:9px;font-weight:700}
.logic-layout{display:grid;grid-template-columns:minmax(300px,.8fr) minmax(620px,1.8fr);gap:14px}.logic-left{min-width:0}.logic-right{min-width:0}.function-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px}.function-group{border:1px solid #e4e7ec;border-radius:8px;padding:8px;background:#f8fafc}.function-group h4{margin:0 0 6px;font-size:10px;text-transform:uppercase;color:#667085;letter-spacing:.04em}.function-group div{font-size:10px;line-height:1.5;color:#344054}
.filter-row{display:grid;grid-template-columns:92px 1.2fr 1fr 1fr 1fr auto;gap:7px;align-items:end;border:1px solid #e4e7ec;border-radius:8px;padding:8px;background:#fafbfc;margin-top:7px}.filter-row .remove{width:auto}
.formula-preview{background:#0f172a;color:#e2e8f0;border-radius:7px;padding:10px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;line-height:1.5;overflow:auto;white-space:pre-wrap}
.validation-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}.validation-card{border:1px solid #e4e7ec;border-radius:8px;padding:11px;background:#fff}.validation-card h4{margin:0 0 5px;color:#23395d}.validation-result{font-size:26px;font-weight:800;color:var(--blue);margin:7px 0}.validation-meta{font-size:10px;color:#667085;line-height:1.5}
.builder{display:grid;grid-template-columns:280px minmax(0,1fr);gap:14px}.palette{border:1px solid #e4e7ec;border-radius:8px;background:#f8fafc;padding:9px;max-height:68vh;overflow:auto}.palette-item{background:#fff;border:1px solid #dfe5ef;border-radius:7px;padding:8px;margin-bottom:6px;cursor:grab}.palette-item b{font-size:11px;color:#23395d}.palette-item small{display:block;color:#667085;margin-top:2px;font-size:9px}.canvas{min-height:60vh;border:2px dashed #cfd6e4;border-radius:10px;padding:12px;background:#fff}.canvas.drag-over{border-color:var(--blue);background:#f8fbff}.dash-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.dash-card{border:1px solid #e4e7ec;border-radius:9px;padding:12px;background:#fff}.dash-card h4{margin:0;color:#23395d;font-size:12px}.dash-value{font-size:26px;font-weight:800;color:var(--blue);margin:8px 0}.dash-series{margin-top:8px}.bar-row{display:grid;grid-template-columns:minmax(90px,.9fr) 2fr auto;gap:7px;align-items:center;margin:5px 0;font-size:9px}.bar-track{height:8px;background:#edf2f7;border-radius:99px;overflow:hidden}.bar-fill{height:100%;background:#0b3d91;border-radius:99px}.component-actions{display:flex;gap:6px;align-items:center;margin-top:8px}.component-actions select{width:auto;min-width:100px;padding:5px}

/* Step 7 dashboard-only additions: promoted-field filters + flexible visualization canvas. */
.promoted-filter-palette{display:flex;gap:7px;flex-wrap:wrap;align-items:stretch}.filter-field-chip{min-width:170px;max-width:260px;background:#fff;border:1px solid #cfd6e4;border-radius:7px;padding:8px 9px;cursor:grab}.filter-field-chip:hover{border-color:#9fb7df;background:#f8fbff}.filter-field-chip b{display:block;font-size:11px;color:#23395d;overflow-wrap:anywhere}.filter-field-chip small{display:block;font-size:9px;color:#667085;margin-top:3px;line-height:1.35}.filter-drop-zone{margin-top:10px;min-height:74px;border:2px dashed #cfd6e4;border-radius:9px;padding:10px;background:#fafbfc}.filter-drop-zone.drag-over{border-color:var(--blue);background:#f0f6ff}.dashboard-filter-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:end}.dashboard-filter{min-width:190px;max-width:310px;flex:1 1 210px;border:1px solid #dfe5ef;border-radius:8px;background:#fff;padding:8px}.dashboard-filter .filter-title{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:10px;font-weight:800;color:#23395d;margin-bottom:6px}.dashboard-filter .filter-title button{width:auto}.dashboard-filter-controls{display:grid;grid-template-columns:minmax(95px,.8fr) minmax(110px,1.2fr);gap:6px}.dashboard-filter-controls .range-second{grid-column:2}.dashboard-filter-note{font-size:9px;color:#667085;margin-top:5px}.dashboard-builder-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:space-between;margin-bottom:10px}.dashboard-builder-toolbar .right{display:flex;gap:7px;flex-wrap:wrap}.dash-grid{grid-template-columns:repeat(12,minmax(0,1fr));align-items:start}.dash-card{grid-column:span 4;min-width:0;cursor:grab}.dash-card.dragging{opacity:.45}.dash-card.drop-before{outline:2px dashed var(--blue);outline-offset:3px}.dash-card img.python-chart{display:block;width:100%;height:auto;max-height:360px;object-fit:contain;border-radius:6px;margin-top:8px}.chart-status{padding:18px;border:1px dashed #cfd6e4;border-radius:7px;color:#667085;text-align:center;font-size:10px;margin-top:8px}.native-chart{width:100%;height:220px;margin-top:8px;display:block}.pie-fallback{width:min(210px,75%);aspect-ratio:1;border-radius:50%;margin:14px auto;border:1px solid #e4e7ec}.chart-legend{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:5px;margin-top:8px;font-size:9px;color:#475467}.chart-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#64748b;margin-right:5px}.python-note{font-size:9px;color:#667085;margin-top:5px}.dashboard-preview-overlay{position:fixed;inset:0;background:#f4f6f9;z-index:100000;display:none;overflow:auto}.dashboard-preview-overlay.active{display:block}.dashboard-preview-shell{max-width:1600px;margin:0 auto;padding:18px}.dashboard-preview-head{position:sticky;top:0;z-index:10;background:#fff;border:1px solid #e4e7ec;border-radius:10px;box-shadow:var(--shadow);padding:12px 14px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;gap:12px}.dashboard-preview-body{background:#fff;border:1px solid #e4e7ec;border-radius:10px;box-shadow:var(--shadow);padding:14px}.dashboard-preview-filters{margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #e4e7ec}.dashboard-preview-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:10px}.builder-help{font-size:10px;color:#667085;line-height:1.45}.palette-section-title{font-size:10px;text-transform:uppercase;letter-spacing:.04em;font-weight:800;color:#667085;margin:11px 0 6px}.metric-palette-scroll{max-height:62vh;overflow:auto}
@media(max-width:1100px){.logic-layout,.builder{grid-template-columns:1fr}.grid.four{grid-template-columns:repeat(2,minmax(0,1fr))}.function-groups{grid-template-columns:1fr}.filter-row{grid-template-columns:1fr 1fr}.dash-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.grid.two,.grid.three,.grid.four{grid-template-columns:1fr}.dash-grid,.dashboard-preview-grid{grid-template-columns:1fr}.dash-card{grid-column:1/-1!important}.page-head{flex-direction:column}.filter-row{grid-template-columns:1fr}.dashboard-filter-controls{grid-template-columns:1fr}.dashboard-filter-controls .range-second{grid-column:auto}.step{padding:12px}}

/* Step 7 only: dashboard intelligence, layout structures and threshold presentation. */
.layout-structure-palette{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:7px}.layout-structure-item{border:1px dashed #9fb7df;background:#f8fbff;border-radius:8px;padding:9px;cursor:grab;text-align:center;color:#23395d;font-size:10px;font-weight:800}.layout-structure-item:hover{background:#eef5ff;border-color:var(--blue)}
.dashboard-layout{display:flex;flex-direction:column;gap:12px}.dash-section{position:relative;border:1px solid #dbe3ef;border-radius:12px;background:#f8fafc;padding:12px;min-height:110px;transition:.15s}.dash-section:hover{border-color:#b7c7df}.dash-section.drag-over{outline:2px dashed var(--blue);outline-offset:2px;background:#f0f6ff}.dash-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px}.dash-section-title{display:flex;align-items:center;gap:7px;font-size:10px;font-weight:800;color:#475467;text-transform:uppercase;letter-spacing:.04em}.dash-section-grid.horizontal{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:10px;align-items:start}.dash-section-grid.vertical{display:flex;flex-direction:column;gap:10px}.dash-section-grid.vertical .dash-card{width:100%!important;grid-column:auto!important}.dash-section-empty{min-height:76px;border:1px dashed #cfd6e4;border-radius:8px;display:flex;align-items:center;justify-content:center;text-align:center;color:#98a2b3;font-size:10px;padding:12px;background:#fff}
.dash-card{position:relative;border:1px solid #e4e7ec;border-top:4px solid #94a3b8;border-radius:12px;padding:13px;background:#fff;box-shadow:0 2px 8px rgba(16,24,40,.07);transition:transform .14s,box-shadow .14s,border-color .14s;outline:none}.dash-card:hover,.dash-card:focus-within,.dash-card.intel-open{transform:translateY(-1px);box-shadow:0 12px 28px rgba(16,24,40,.14)}.dash-card.status-good{border-top-color:#16a34a}.dash-card.status-watch{border-top-color:#f59e0b}.dash-card.status-critical{border-top-color:#dc2626}.dash-card.status-neutral{border-top-color:#64748b}.dash-card.status-good .dash-value{color:#15803d}.dash-card.status-watch .dash-value{color:#b45309}.dash-card.status-critical .dash-value{color:#b42318}.dash-card-status{display:flex;align-items:center;gap:6px;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.status-dot{width:8px;height:8px;border-radius:50%;background:#64748b}.status-good .status-dot{background:#16a34a}.status-watch .status-dot{background:#f59e0b}.status-critical .status-dot{background:#dc2626}
.intel-summary{display:none;position:absolute;z-index:40;top:calc(100% + 8px);left:0;width:min(520px,calc(100vw - 90px));max-height:430px;overflow:auto;background:#fff;border:1px solid #d9e1ec;border-radius:12px;box-shadow:0 20px 46px rgba(16,24,40,.20);padding:13px}.dash-card:hover>.intel-summary,.dash-card:focus-within>.intel-summary,.dash-card.intel-open>.intel-summary{display:block}.intel-summary h5{margin:0 0 7px;color:var(--blue);font-size:13px}.intel-summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.intel-item{background:#f8fafc;border:1px solid #e4e7ec;border-radius:7px;padding:8px;min-width:0}.intel-item b{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.04em;color:#667085;margin-bottom:3px}.intel-item div{font-size:10px;line-height:1.4;color:#344054;overflow-wrap:anywhere}.intel-wide{grid-column:1/-1}.intel-btn{width:auto!important;padding:4px 7px!important;border-radius:999px!important;font-size:10px!important}.threshold-editor{display:none;margin-top:8px;padding:9px;border:1px solid #e4e7ec;border-radius:8px;background:#f8fafc}.threshold-editor.active{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.threshold-editor .field label{font-size:8px}.threshold-editor input,.threshold-editor select{padding:6px 7px;font-size:10px}.threshold-legend{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.threshold-legend span{font-size:8px;font-weight:800;border-radius:999px;padding:3px 6px}.threshold-legend .g{background:#ecfdf3;color:#15803d}.threshold-legend .w{background:#fff7ed;color:#b45309}.threshold-legend .c{background:#fef2f2;color:#b42318}
.preview-intel-note{font-size:9px;color:#667085;margin-top:6px}.dashboard-preview-grid{display:block}.dashboard-preview-grid .dashboard-layout{gap:14px}.dashboard-preview-grid .dash-section{background:#fff;border-color:#e4e7ec}.dashboard-preview-grid .dash-card{cursor:default}.dashboard-preview-grid .dash-card:hover{transform:none}
