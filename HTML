function closeDashboardView(){const overlay=document.getElementById('dashboardPreviewOverlay');overlay.classList.remove('active');overlay.setAttribute('aria-hidden','true')}
async function refreshDashboardPreview(){const db=ensureDashboardShape(dashboardById(state.currentDashboardId));if(!db)return closeDashboardView();document.getElementById('dashboardPreviewTitle').textContent=db.name;await renderDashboardFilters('dashboardPreviewFilters',false);await renderDashboardSections(document.getElementById('dashboardPreviewGrid'),db,true)}

function reconcileStateReferences(){const sourceIds=new Set(state.sources.map(s=>s.id));for(const [id,f] of Object.entries(state.fields))if(!sourceIds.has(f.sourceId))delete state.fields[id];const fieldIds=new Set(Object.keys(state.fields));state.relationships=(state.relationships||[]).filter(r=>fieldIds.has(r.leftFieldId)&&fieldIds.has(r.rightFieldId));state.concepts=(state.concepts||[]).map(c=>({...c,fieldIds:(c.fieldIds||[]).filter(id=>fieldIds.has(id))}));let metrics=(state.metrics||[]).filter(m=>m.mode==='derived'||sourceIds.has(m.sourceId));let changed=true;while(changed){changed=false;const mids=new Set(metrics.map(m=>m.id));const next=metrics.filter(m=>m.mode!=='derived'||(mids.has(m.derivedLeftMetricId)&&mids.has(m.derivedRightMetricId)));if(next.length!==metrics.length){metrics=next;changed=true}}state.metrics=metrics;const mids=new Set(state.metrics.map(m=>m.id));for(const d of state.dashboards||[]){ensureDashboardShape(d);d.filters=(d.filters||[]).filter(f=>fieldIds.has(f.fieldId));d.components=(d.components||[]).filter(c=>mids.has(c.metricId)&&(!c.visualMap?.yMetricId||mids.has(c.visualMap.yMetricId)));d.components.forEach(c=>{if(c.visualMap&&!fieldIds.has(c.visualMap.xFieldId))c.visualMap.xFieldId='';if(c.visualMap&&!fieldIds.has(c.visualMap.seriesFieldId))c.visualMap.seriesFieldId=''});const valid=new Set(d.components.map(c=>c.id));(d.sections||[]).forEach(sec=>sec.componentIds=(sec.componentIds||[]).filter(id=>valid.has(id)))}if(state.currentSourceId&&!sourceIds.has(state.currentSourceId))state.currentSourceId=state.sources.at(-1)?.id||'';if(state.currentDashboardId&&!state.dashboards.some(d=>d.id===state.currentDashboardId))state.currentDashboardId=state.dashboards.at(-1)?.id||'';saveState()}
async function resetEverything(){if(!confirm('Delete all uploaded source registrations, staged fields, relationships, concepts, metrics, validation results, and working dashboards from this lab?'))return;state=freshState();saveState();rowCache.clear();await dbClear();document.getElementById('uploadStatus').className='notice';document.getElementById('uploadStatus').textContent='No source uploaded yet.';showStep(0)}

reconcileStateReferences();
renderSourceInventory();
</script>
