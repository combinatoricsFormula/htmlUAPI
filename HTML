function saveMetricDraft(){const d=metricFormData();if(!d.name||!d.definition)return alert('Metric name and definition are required.');if(d.mode!=='derived'&&!d.sourceId)return alert('Choose a source.');if(d.mode==='aggregate'&&d.aggregation!=='COUNT_ROWS'&&!d.fieldId)return alert('Choose a field for the aggregation.');if(d.mode==='datediff'&&(!d.dateStartFieldId||!d.dateEndFieldId))return alert('Choose both date fields.');if(d.mode==='derived'&&(!d.derivedLeftMetricId||!d.derivedRightMetricId))return alert('Choose left and right metrics.');if(d.filters.some(f=>!f.fieldId))return alert('Every filter needs a field.');const editId=document.getElementById('metricName').dataset.editId||'';if(editId){const m=metricById(editId);Object.assign(m,d,{status:'Draft',validation:null,updatedAt:new Date().toISOString()})}else state.metrics.push(Object.assign({id:'metric_'+Date.now().toString(36),status:'Draft',validation:null,createdAt:new Date().toISOString()},d));saveState();clearMetricBuilder();renderMetricBuilder()}
