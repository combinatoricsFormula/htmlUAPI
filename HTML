function filterToText(f){const field=fieldById(f.fieldId)?.header||'[field]';const noValue=['IS NULL','IS NOT NULL','IS TRUE','IS FALSE'].includes(f.op);const between=f.op==='BETWEEN';return `${field} ${f.op}${noValue?'':between?` ${JSON.stringify(f.value)} AND ${JSON.stringify(f.value2)}`:` ${JSON.stringify(f.value)}`}`}
function buildFormulaPreview(){const mode=document.getElementById('metricMode')?.value||'aggregate';let core='';if(mode==='aggregate'){const agg=document.getElementById('metricAgg').value,f=fieldById(document.getElementById('metricField').value),p=document.getElementById('metricPercentile').value;core=agg==='COUNT_ROWS'?'COUNT_ROWS()':agg==='PERCENTILE'?`PERCENTILE(${f?.header||'[field]'}, ${p})`:`${agg}(${f?.header||'[field]'})`}else if(mode==='datediff'){const a=fieldById(document.getElementById('dateStart').value),b=fieldById(document.getElementById('dateEnd').value),unit=document.getElementById('dateUnit').value,agg=document.getElementById('dateAgg').value;core=`${agg}(DATEDIFF(${a?.header||'[start]'}, ${b?.header||'[end]'}, ${unit}))`}else{const l=metricById(document.getElementById('derivedLeft').value),r=metricById(document.getElementById('derivedRight').value),op=document.getElementById('derivedOp').value,scale=document.getElementById('derivedScale').value||1;core=`(${l?.name||'[left metric]'} ${op} ${r?.name||'[right metric]'}) * ${scale}`}if(draftFilters.length&&mode!=='derived'){core+='\nWHERE '+draftFilters.map((f,i)=>(i?`${f.conjunction} `:'')+filterToText(f)).join('\n      ')}const g=fieldById(document.getElementById('metricGroupBy')?.value);if(g)core+=`\nGROUP BY ${g.header}`;return core}
