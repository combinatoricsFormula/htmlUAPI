<body>
<script id="esiOfflineNetworkGuard">
(()=>{
  const blocked=()=>Promise.reject(new Error('Outbound network access is disabled in this offline build.'));
  try{window.fetch=blocked}catch(e){}
  try{window.XMLHttpRequest=function(){throw new Error('Outbound network access is disabled in this offline build.')}}catch(e){}
  try{window.WebSocket=function(){throw new Error('Outbound network access is disabled in this offline build.')}}catch(e){}
  try{window.EventSource=function(){throw new Error('Outbound network access is disabled in this offline build.')}}catch(e){}
  try{if(navigator&&navigator.sendBeacon)navigator.sendBeacon=()=>false}catch(e){}
  window.__ESI_OFFLINE_DEVICE_ONLY__=true;
})();
</script>
<header>
  <div><h1>Enterprise Service Intelligence — From Scratch <span class="offline-badge" title="Outbound network access is blocked by this build">OFFLINE · DEVICE ONLY</span></h1><small>No prebuilt concepts · No prebuilt metrics · No Enterprise Dashboard assumptions</small></div>
  <div class="actions"><button class="btn" onclick="resetEverything()">Reset Lab</button></div>
</header>
<nav class="workflow" id="workflow" aria-label="Build workflow">
  <button data-step="0" class="active" onclick="showStep(0)">STEP 0 · Upload</button>
  <button data-step="1" onclick="showStep(1)">STEP 1 · Source Profile</button>
  <button data-step="2" onclick="showStep(2)">STEP 2 · Field Staging</button>
  <button data-step="3" onclick="showStep(3)">STEP 3 · Relationships / Keys</button>
  <button data-step="4" onclick="showStep(4)">STEP 4 · Business Concepts</button>
  <button data-step="5" onclick="showStep(5)">STEP 5 · Business Logic / Metrics</button>
  <button data-step="6" onclick="showStep(6)">STEP 6 · Validate</button>
  <button data-step="7" onclick="showStep(7)">STEP 7 · Dashboard Builder</button>
</nav>
<div class="shell">
<section class="step active" id="step0"><div class="page">
  <div class="page-head"><div><div class="eyebrow">Step 0</div><h2>Upload One Source CSV</h2><p>Upload one CSV at a time. The application registers the raw source and extracts structure only. It does not assign business meaning, metrics, formulas, or dashboards.</p></div></div>
  <section class="panel">
    <div class="grid two">
      <div><h3>Source Upload</h3><p>For your first pass, upload <b>task_sla.csv</b>. Later you can return here and add the next CSV without losing the model already built.</p><div class="actions"><button class="btn primary" onclick="document.getElementById('sourceFile').click()">Choose CSV</button><input id="sourceFile" type="file" accept=".csv,text/csv" hidden onchange="uploadOneSource(this.files[0]);this.value=''" /></div><div id="uploadStatus" class="notice" style="margin-top:10px">No source uploaded yet.</div></div>
      <div><h3>Rules for This Build</h3><div class="notice warn"><b>Nothing is prebuilt.</b><br>0 business concepts · 0 metrics · 0 dashboards on a clean start. Only structural profiling is automatic.</div></div>
    </div>
  </section>
  <section class="panel"><h3>Source Inventory</h3><div id="sourceInventory"></div></section>
</div></section>

<section class="step" id="step1"><div class="page">
  <div class="page-head"><div><div class="eyebrow">Step 1</div><h2>Raw Source Registration + Profiling</h2><p>Understand the physical file before interpreting it. Row counts, headers, nulls, distinct values, types, ranges, duplicates, and sample values are structural facts—not business meaning.</p></div><div class="actions"><button class="btn primary" onclick="showStep(2)">Continue to Field Staging</button></div></div>
  <div id="profileSourcePicker" class="source-list"></div>
  <div id="profileContent"></div>
</div></section>

<section class="step" id="step2"><div class="page">
  <div class="page-head"><div><div class="eyebrow">Step 2</div><h2>Understand Each Header — Field Staging</h2><p>Review every header and decide whether it is promoted, held, or ignored. You can record what the field means and assign a structural role. No business concept is created automatically.</p></div><div class="actions"><button class="btn primary" onclick="showStep(3)">Continue to Relationships / Keys</button></div></div>
  <div id="fieldSourcePicker" class="source-list"></div>
  <section class="panel"><div id="fieldStageContent"></div></section>
</div></section>

<section class="step" id="step3"><div class="page">
  <div class="page-head"><div><div class="eyebrow">Step 3</div><h2>Identify Relationships / Keys</h2><p>Mark primary keys and relationship keys explicitly. When a second source is uploaded, build source-to-source relationships here. Candidate uniqueness and name/value overlap are evidence only; the user confirms the relationship.</p></div><div class="actions"><button class="btn primary" onclick="showStep(4)">Continue to Business Concepts</button></div></div>
  <section class="panel"><h3>Key Candidates</h3><div id="keyCandidates"></div></section>
  <section class="panel"><h3>Confirmed Relationships</h3><div class="grid four" style="align-items:end"><div class="field"><label>Left Field</label><select id="relLeft"></select></div><div class="field"><label>Relationship</label><select id="relType"><option value="equals">Equals / Join</option><option value="parent-child">Parent → Child</option><option value="reference">Reference</option></select></div><div class="field"><label>Right Field</label><select id="relRight"></select></div><div><button class="btn primary" onclick="addRelationship()">Add Relationship</button></div></div><div id="relationshipList" style="margin-top:12px"></div></section>
</div></section>

<section class="step" id="step4"><div class="page">
  <div class="page-head"><div><div class="eyebrow">Step 4</div><h2>Define Business Concepts</h2><p>This library starts empty. Create only the concepts your business actually needs, based on fields you reviewed and relationships you confirmed.</p></div><div class="actions"><button class="btn primary" onclick="showStep(5)">Continue to Business Logic / Metrics</button></div></div>
  <div class="grid two">
    <section class="panel"><h3>Create Concept</h3><div class="field"><label>Business Concept Name</label><input id="conceptName" placeholder="e.g. SLA Breach" /></div><div class="field" style="margin-top:8px"><label>Business Definition</label><textarea id="conceptDefinition" placeholder="Define the concept in your own business terms."></textarea></div><div class="field" style="margin-top:8px"><label>Related Promoted Fields</label><select id="conceptFields" multiple size="8"></select><small>Select one or more fields. Ctrl/Cmd-click for multiple selection.</small></div><div class="actions" style="margin-top:10px"><button class="btn primary" onclick="saveConcept()">Create Concept</button></div></section>
    <section class="panel"><h3>Business Concept Library</h3><div id="conceptList"></div></section>
  </div>
</div></section>

<section class="step" id="step5"><div class="page">
  <div class="page-head"><div><div class="eyebrow">Step 5</div><h2>Create Business Logic / Metrics</h2><p>Build calculations from scratch. Filters are first-class: equality, inequality, IN/NOT IN, contains, starts/ends with, numeric comparisons, BETWEEN, null tests, boolean tests, and date comparisons can all be combined with AND/OR before aggregation.</p></div><div class="actions"><button class="btn primary" onclick="showStep(6)">Continue to Validation</button></div></div>
  <div class="logic-layout">
    <section class="panel logic-left"><h3>Metric Registry</h3><div id="metricList"></div></section>
    <section class="panel logic-right"><h3>Metric Builder</h3>
      <div class="grid four">
        <div class="field"><label>Metric Name</label><input id="metricName" placeholder="e.g. Breached SLA Records" /></div>
        <div class="field"><label>Business Concept</label><select id="metricConcept"><option value="">None</option></select></div>
        <div class="field"><label>Source</label><select id="metricSource" onchange="metricSourceChanged()"></select></div>
        <div class="field"><label>Unit</label><input id="metricUnit" placeholder="count, %, hours..." /></div>
      </div>
      <div class="field" style="margin-top:8px"><label>Metric Definition</label><textarea id="metricDefinition" placeholder="What exactly does this calculation mean?"></textarea></div>
      <div class="grid four" style="margin-top:8px">
        <div class="field"><label>Calculation Mode</label><select id="metricMode" onchange="renderMetricMode()"><option value="aggregate">Aggregate</option><option value="datediff">Date Difference</option><option value="derived">Derived Metric</option></select></div>
        <div class="field aggregate-mode"><label>Aggregation</label><select id="metricAgg" onchange="renderFormulaPreview()"><option value="COUNT_ROWS">COUNT ROWS</option><option value="COUNT">COUNT</option><option value="COUNT_DISTINCT">COUNT DISTINCT</option><option value="SUM">SUM</option><option value="AVG">AVERAGE</option><option value="MIN">MIN</option><option value="MAX">MAX</option><option value="MEDIAN">MEDIAN</option><option value="PERCENTILE">PERCENTILE</option></select></div>
        <div class="field aggregate-mode"><label>Field</label><select id="metricField" onchange="renderFormulaPreview()"></select></div>
        <div class="field aggregate-mode"><label>Percentile</label><input id="metricPercentile" type="number" min="0" max="100" value="95" oninput="renderFormulaPreview()" /></div>
      </div>
      <div id="datediffMode" class="grid four" style="margin-top:8px;display:none"><div class="field"><label>Start Field</label><select id="dateStart" onchange="renderFormulaPreview()"></select></div><div class="field"><label>End Field</label><select id="dateEnd" onchange="renderFormulaPreview()"></select></div><div class="field"><label>Unit</label><select id="dateUnit" onchange="renderFormulaPreview()"><option>seconds</option><option>minutes</option><option selected>hours</option><option>days</option></select></div><div class="field"><label>Aggregate Duration</label><select id="dateAgg" onchange="renderFormulaPreview()"><option>AVG</option><option>SUM</option><option>MIN</option><option>MAX</option><option>MEDIAN</option></select></div></div>
      <div id="derivedMode" class="grid four" style="margin-top:8px;display:none"><div class="field"><label>Left Metric</label><select id="derivedLeft" onchange="renderFormulaPreview()"></select></div><div class="field"><label>Operator</label><select id="derivedOp" onchange="renderFormulaPreview()"><option value="+">+</option><option value="-">−</option><option value="*">×</option><option value="/">÷</option></select></div><div class="field"><label>Right Operand</label><select id="derivedRight" onchange="renderFormulaPreview()"></select></div><div class="field"><label>Scale Result By</label><input id="derivedScale" type="number" value="1" step="any" oninput="renderFormulaPreview()" /><small>Use 100 for percentages.</small></div></div>
      <div class="function-groups">
        <div class="function-group"><h4>Aggregations</h4><div>COUNT ROWS · COUNT · COUNT DISTINCT · SUM · AVG · MIN · MAX · MEDIAN · PERCENTILE</div></div>
        <div class="function-group"><h4>Conditional / Filter</h4><div>= · != · &gt; · &gt;= · &lt; · &lt;= · IN · NOT IN · CONTAINS · NOT CONTAINS · STARTS WITH · ENDS WITH · BETWEEN · IS NULL · IS NOT NULL · IS TRUE · IS FALSE</div></div>
        <div class="function-group"><h4>Date / Boolean / Derived</h4><div>BEFORE · AFTER · ON OR BEFORE · ON OR AFTER · AND · OR · NOT · DATEDIFF · + · − · × · ÷ · scale</div></div>
      </div>
      <section style="margin-top:12px"><div class="actions"><h3 style="margin:0">Filters</h3><button class="btn small" onclick="addFilter()">+ Add Filter</button></div><div id="filterRows"></div></section>
      <div class="field" style="margin-top:10px"><label>Optional Group / Trend Dimension</label><select id="metricGroupBy" onchange="renderFormulaPreview()"><option value="">None</option></select></div>
      <div style="margin-top:10px"><label>Formula Preview</label><div id="formulaPreview" class="formula-preview">—</div></div>
      <div class="actions" style="margin-top:10px"><button class="btn" onclick="clearMetricBuilder()">Clear</button><button class="btn primary" onclick="saveMetricDraft()">Save Draft Metric</button></div>
    </section>
  </div>
</div></section>

<section class="step" id="step6"><div class="page">
  <div class="page-head"><div><div class="eyebrow">Step 6</div><h2>Validate Calculations</h2><p>Execute draft metrics against the actual uploaded rows. Validation shows the computed result, population, matched filter rows, invalid numeric/date values, and grouping preview. Only explicitly approved metrics become available to the dashboard builder.</p></div><div class="actions"><button class="btn" onclick="validateAllMetrics()">Validate All</button><button class="btn primary" onclick="showStep(7)">Continue to Dashboard Builder</button></div></div>
  <div id="validationContent" class="validation-grid"></div>
</div></section>

<section class="step" id="step7"><div class="page">
  <div class="page-head"><div><div class="eyebrow">Step 7</div><h2>Build Our First Dashboard</h2><p>Start with a blank working dashboard. All promoted fields are available for dashboard filtering; validated/approved metrics are available as dashboard components. Nothing touches an Enterprise Dashboard.</p></div><div class="actions"><button class="btn primary" id="viewDashboardButton" onclick="viewDashboard()">View Dashboard</button></div></div>
  <section class="panel"><div class="grid three" style="align-items:end"><div class="field"><label>Dashboard Name</label><input id="dashboardName" placeholder="e.g. Task SLA Intelligence" /></div><div class="field"><label>Existing Dashboard</label><select id="dashboardSelect" onchange="selectDashboard(this.value)"><option value="">None</option></select></div><div class="actions"><button class="btn primary" onclick="createDashboard()">Create Blank Dashboard</button><button class="btn danger" onclick="deleteDashboard()">Delete</button></div></div></section>
  <section class="panel"><div class="dashboard-builder-toolbar"><div><h3 style="margin:0">Promoted Fields — Dashboard Filters</h3><div class="builder-help">Every promoted field is available here. Drag any field into the filter area. Date/time fields support Year, Quarter, Month and date-range filtering; text, number and boolean fields expose appropriate operators.</div></div></div><div id="dashboardFieldPalette" class="promoted-filter-palette"></div><div id="dashboardFilterZone" class="filter-drop-zone" ondragover="dashboardFilterDragOver(event)" ondragleave="dashboardFilterDragLeave(event)" ondrop="dashboardFilterDrop(event)"><div id="dashboardFilterBar"></div></div></section>
  <div class="builder"><aside class="palette"><h3>Approved Metrics</h3><p class="muted" style="font-size:10px">Drag metrics into a horizontal or vertical structure. Components can be moved, reordered and resized after placement.</p><div id="dashboardMetricPalette" class="metric-palette-scroll"></div><div class="palette-section-title">Layout structures</div><div class="layout-structure-palette"><div class="layout-structure-item" draggable="true" ondragstart="dragDashboardStructure(event,'horizontal')" ondblclick="addDashboardSection('horizontal')">Horizontal Row</div><div class="layout-structure-item" draggable="true" ondragstart="dragDashboardStructure(event,'vertical')" ondblclick="addDashboardSection('vertical')">Vertical Stack</div></div><div class="palette-section-title">Visualization engine</div><div class="builder-help">KPI · Table · Bar · Line · Pie · Scatter. Charts use Pandas + NumPy + Matplotlib in-browser when available, with a native fallback.</div></aside><main><div id="dashboardCanvas" class="canvas" ondragover="dashboardDragOver(event)" ondragleave="dashboardDragLeave(event)" ondrop="dashboardDrop(event)"></div></main></div>
</div></section>
<div class="dashboard-preview-overlay" id="dashboardPreviewOverlay" aria-hidden="true"><div class="dashboard-preview-shell"><div class="dashboard-preview-head"><div><div class="eyebrow">Working Dashboard</div><h2 id="dashboardPreviewTitle" style="margin:0;color:var(--blue)">Dashboard</h2></div><div class="actions"><button class="btn" onclick="refreshDashboardPreview()">Refresh</button><button class="btn primary" onclick="closeDashboardView()">Back to Builder</button></div></div><div class="dashboard-preview-body"><div id="dashboardPreviewFilters" class="dashboard-preview-filters"></div><div id="dashboardPreviewGrid" class="dashboard-preview-grid"></div></div></div></div>
</div>
<script>
'use strict';
const STORAGE_KEY='esi_from_scratch_state_v1';
const DB_NAME='esi_from_scratch_sources_v1';
const DB_STORE='sources';
const rowCache=new Map();
let activeStep=0;
let dragMetricId='';
let dragFieldId='';
let dragComponentId='';
const freshState=()=>({version:1,sources:[],currentSourceId:'',fields:{},relationships:[],concepts:[],metrics:[],dashboards:[],currentDashboardId:''});
let state=loadState();
function loadState(){try{const x=JSON.parse(localStorage.getItem(STORAGE_KEY)||'');return x&&x.version===1?Object.assign(freshState(),x):freshState()}catch(_){return freshState()}}
function saveState(){localStorage.setItem(STORAGE_KEY,JSON.stringify(state))}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function slug(v){return String(v??'').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'')||'item'}
function fmt(n,d=0){return Number.isFinite(Number(n))?Number(n).toLocaleString(undefined,{maximumFractionDigits:d}):'—'}
function pct(n,d=1){return Number.isFinite(Number(n))?Number(n).toFixed(d)+'%':'—'}
function sourceById(id){return state.sources.find(s=>s.id===id)||null}
function fieldById(id){return state.fields[id]||null}
function metricById(id){return state.metrics.find(m=>m.id===id)||null}
function dashboardById(id){return state.dashboards.find(d=>d.id===id)||null}
function currentSource(){return sourceById(state.currentSourceId)||state.sources.at(-1)||null}
function showStep(n){activeStep=Number(n);document.querySelectorAll('.step').forEach((el,i)=>el.classList.toggle('active',i===activeStep));document.querySelectorAll('.workflow button').forEach(b=>b.classList.toggle('active',Number(b.dataset.step)===activeStep));renderStep(activeStep)}
function renderStep(n){if(n===0)renderSourceInventory();if(n===1)renderProfile();if(n===2)renderFieldStaging();if(n===3)renderRelationships();if(n===4)renderConcepts();if(n===5)renderMetricBuilder();if(n===6)renderValidation();if(n===7)renderDashboardBuilder()}

function openDb(){return new Promise((resolve,reject)=>{const req=indexedDB.open(DB_NAME,1);req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains(DB_STORE))db.createObjectStore(DB_STORE,{keyPath:'id'})};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)})}
async function dbPutSource(obj){const db=await openDb();await new Promise((resolve,reject)=>{const tx=db.transaction(DB_STORE,'readwrite');tx.objectStore(DB_STORE).put(obj);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)});db.close()}
async function dbGetSource(id){const db=await openDb();const result=await new Promise((resolve,reject)=>{const tx=db.transaction(DB_STORE,'readonly');const r=tx.objectStore(DB_STORE).get(id);r.onsuccess=()=>resolve(r.result||null);r.onerror=()=>reject(r.error)});db.close();return result}
async function dbDeleteSource(id){const db=await openDb();await new Promise((resolve,reject)=>{const tx=db.transaction(DB_STORE,'readwrite');tx.objectStore(DB_STORE).delete(id);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)});db.close()}
async function dbClear(){const db=await openDb();await new Promise((resolve,reject)=>{const tx=db.transaction(DB_STORE,'readwrite');tx.objectStore(DB_STORE).clear();tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)});db.close()}

function parseCsv(text){const rows=[];let row=[],cell='',quoted=false;for(let i=0;i<text.length;i++){const c=text[i],n=text[i+1];if(quoted){if(c==='"'&&n==='"'){cell+='"';i++}else if(c==='"'){quoted=false}else cell+=c}else{if(c==='"')quoted=true;else if(c===','){row.push(cell);cell=''}else if(c==='\n'){row.push(cell);rows.push(row);row=[];cell=''}else if(c!=='\r')cell+=c}}if(cell.length||row.length){row.push(cell);rows.push(row)}if(!rows.length)return{headers:[],rows:[]};const rawHeaders=rows.shift().map((h,i)=>String(h||`column_${i+1}`).trim());const seen={};const headers=rawHeaders.map(h=>{const k=h||'column';seen[k]=(seen[k]||0)+1;return seen[k]===1?k:`${k}__${seen[k]}`});const objs=rows.filter(r=>r.some(v=>String(v).trim()!=='')).map(r=>Object.fromEntries(headers.map((h,i)=>[h,r[i]??''])));return{headers,rows:objs}}
function isBlank(v){return v===null||v===undefined||String(v).trim()===''}
function truthyValue(v){const s=String(v??'').trim().toLowerCase();return ['true','1','yes','y','t'].includes(s)}
function falseyValue(v){const s=String(v??'').trim().toLowerCase();return ['false','0','no','n','f'].includes(s)}
function detectType(values){const vals=values.filter(v=>!isBlank(v));if(!vals.length)return'Empty';const sample=vals.slice(0,500);if(sample.every(v=>truthyValue(v)||falseyValue(v)))return'Boolean';if(sample.every(v=>Number.isFinite(Number(String(v).replace(/[$,%]/g,'')))))return'Number';const dateLike=sample.filter(v=>{const s=String(v).trim();return /[-/:T]/.test(s)&&Number.isFinite(Date.parse(s))}).length;if(dateLike/sample.length>=.9)return'Date/Time';return'Text'}
function profileField(rows,header){const vals=rows.map(r=>r[header]);const nonblank=vals.filter(v=>!isBlank(v));const distinct=new Set(nonblank.map(v=>String(v))).size;const type=detectType(vals);let min='—',max='—';if(type==='Number'){const nums=nonblank.map(v=>Number(String(v).replace(/[$,%]/g,''))).filter(Number.isFinite);if(nums.length){min=Math.min(...nums);max=Math.max(...nums)}}else if(type==='Date/Time'){const ds=nonblank.map(v=>Date.parse(v)).filter(Number.isFinite);if(ds.length){min=new Date(Math.min(...ds)).toISOString();max=new Date(Math.max(...ds)).toISOString()}}return{dataType:type,nullCount:vals.length-nonblank.length,nullPct:vals.length?((vals.length-nonblank.length)/vals.length*100):0,distinctCount:distinct,distinctPct:vals.length?(distinct/vals.length*100):0,min,max,sample:nonblank.slice(0,4).map(String)}}
function profileSource(parsed){const serialized=parsed.rows.map(r=>parsed.headers.map(h=>String(r[h]??'')).join('\u001f'));const dup=serialized.length-new Set(serialized).size;return{rowCount:parsed.rows.length,columnCount:parsed.headers.length,duplicateRows:dup,fields:Object.fromEntries(parsed.headers.map(h=>[h,profileField(parsed.rows,h)]))}}
function defaultRole(type){if(type==='Date/Time')return'Date/Time';if(type==='Boolean')return'Flag';if(type==='Number')return'Measure';return'Unknown'}

async function uploadOneSource(file){if(!file)return;const status=document.getElementById('uploadStatus');const sameName=state.sources.filter(s=>s.name===file.name);if(sameName.length&&!confirm(`A source named ${file.name} is already registered. Upload this as another source version?`))return;status.className='notice';status.textContent='Reading '+file.name+'...';try{const text=await file.text();const parsed=parseCsv(text);if(!parsed.headers.length)throw new Error('No CSV headers found.');const id='src_'+slug(file.name.replace(/\.csv$/i,''))+'_'+Date.now().toString(36);const profile=profileSource(parsed);const meta={id,name:file.name,size:file.size,headers:parsed.headers,rowCount:parsed.rows.length,uploadedAt:new Date().toISOString(),profile};state.sources.push(meta);state.currentSourceId=id;for(const h of parsed.headers){const p=profile.fields[h],fid=id+'::'+h;state.fields[fid]={id:fid,sourceId:id,header:h,dataType:p.dataType,status:'Unreviewed',role:defaultRole(p.dataType),meaning:'',isPrimaryKey:false,isRelationshipKey:false}}rowCache.set(id,parsed.rows);await dbPutSource({id,name:file.name,text});saveState();status.className='notice good';status.textContent=`${file.name} registered: ${fmt(parsed.rows.length)} rows · ${parsed.headers.length} headers. Continue to Step 1.`;renderSourceInventory()}catch(err){status.className='notice warn';status.textContent='Upload failed: '+(err?.message||err)}}
async function getRows(sourceId){if(rowCache.has(sourceId))return rowCache.get(sourceId);const rec=await dbGetSource(sourceId);if(!rec){const s=sourceById(sourceId);throw new Error(`Raw CSV data is unavailable for ${s?.name||sourceId}. Re-upload the file or delete the stale source registration.`)}const rows=parseCsv(rec.text).rows;rowCache.set(sourceId,rows);return rows}

function sourceMetricDependencyIds(sourceId){const fieldIds=new Set(Object.values(state.fields).filter(f=>f.sourceId===sourceId).map(f=>f.id)),ids=new Set(state.metrics.filter(m=>m.sourceId===sourceId||fieldIds.has(m.fieldId)||fieldIds.has(m.dateStartFieldId)||fieldIds.has(m.dateEndFieldId)||fieldIds.has(m.groupByFieldId)||(m.filters||[]).some(f=>fieldIds.has(f.fieldId))).map(m=>m.id));let changed=true;while(changed){changed=false;for(const m of state.metrics){if(ids.has(m.id))continue;if(m.mode==='derived'&&(ids.has(m.derivedLeftMetricId)||ids.has(m.derivedRightMetricId))){ids.add(m.id);changed=true}}}return ids}
function sourceDependencySummary(sourceId){const fieldIds=new Set(Object.values(state.fields).filter(f=>f.sourceId===sourceId).map(f=>f.id)),metricIds=sourceMetricDependencyIds(sourceId),relationships=state.relationships.filter(r=>fieldIds.has(r.leftFieldId)||fieldIds.has(r.rightFieldId)).length,conceptLinks=state.concepts.reduce((n,c)=>n+(c.fieldIds||[]).filter(id=>fieldIds.has(id)).length,0);let dashboardFilters=0,dashboardComponents=0,visualMappings=0;for(const d of state.dashboards){dashboardFilters+=(d.filters||[]).filter(f=>fieldIds.has(f.fieldId)).length;dashboardComponents+=(d.components||[]).filter(c=>metricIds.has(c.metricId)||metricIds.has(c.visualMap?.yMetricId)).length;visualMappings+=(d.components||[]).filter(c=>fieldIds.has(c.visualMap?.xFieldId)||fieldIds.has(c.visualMap?.seriesFieldId)).length}return{fieldIds,metricIds,relationships,conceptLinks,dashboardFilters,dashboardComponents,visualMappings}}
async function deleteSource(sourceId){const s=sourceById(sourceId);if(!s)return;const dep=sourceDependencySummary(sourceId);const msg=`Delete ${s.name}?\n\nThis safely removes its raw CSV data and ${dep.fieldIds.size} staged field(s), ${dep.relationships} relationship(s), ${dep.metricIds.size} dependent metric(s), ${dep.dashboardFilters} dashboard filter(s), ${dep.dashboardComponents} dashboard component(s), and clears ${dep.visualMappings} X/Series mapping(s). Business concept definitions and dashboard shells are preserved.`;if(!confirm(msg))return;const fieldIds=dep.fieldIds,metricIds=dep.metricIds;state.sources=state.sources.filter(x=>x.id!==sourceId);for(const id of fieldIds)delete state.fields[id];state.relationships=state.relationships.filter(r=>!fieldIds.has(r.leftFieldId)&&!fieldIds.has(r.rightFieldId));state.concepts.forEach(c=>c.fieldIds=(c.fieldIds||[]).filter(id=>!fieldIds.has(id)));state.metrics=state.metrics.filter(m=>!metricIds.has(m.id));for(const d of state.dashboards){d.filters=(d.filters||[]).filter(f=>!fieldIds.has(f.fieldId));d.components=(d.components||[]).filter(c=>!metricIds.has(c.metricId)&&!metricIds.has(c.visualMap?.yMetricId));d.components.forEach(c=>{if(fieldIds.has(c.visualMap?.xFieldId))c.visualMap.xFieldId='';if(fieldIds.has(c.visualMap?.seriesFieldId))c.visualMap.seriesFieldId=''});const valid=new Set(d.components.map(c=>c.id));(d.sections||[]).forEach(sec=>sec.componentIds=(sec.componentIds||[]).filter(id=>valid.has(id)))}if(state.currentSourceId===sourceId)state.currentSourceId=state.sources.at(-1)?.id||'';rowCache.delete(sourceId);await dbDeleteSource(sourceId);saveState();renderStep(activeStep)}
async function clearCsvSources(){if(!state.sources.length)return;if(!confirm(`Clear all ${state.sources.length} CSV source(s)?\n\nRaw CSV data, staged fields, relationships, metrics, validations, dashboard filters/components and source-field links will be removed. Business concept definitions and empty dashboard shells will be preserved. Use Reset Lab to delete absolutely everything.`))return;state.sources=[];state.currentSourceId='';state.fields={};state.relationships=[];state.concepts.forEach(c=>c.fieldIds=[]);state.metrics=[];state.dashboards.forEach(d=>{d.filters=[];d.components=[];(d.sections||[]).forEach(sec=>sec.componentIds=[])});rowCache.clear();await dbClear();saveState();document.getElementById('uploadStatus').className='notice';document.getElementById('uploadStatus').textContent='CSV sources cleared. Business concepts and dashboard shells were preserved.';renderStep(activeStep)}
async function refreshSourceHealth(){for(const s of state.sources){const el=document.getElementById('sourceHealth_'+s.id);if(!el)continue;try{const rec=await dbGetSource(s.id);el.className='badge '+(rec?'good':'warn');el.textContent=rec?'Raw data ready':'Raw data missing'}catch(_){el.className='badge warn';el.textContent='Storage check failed'}}}
function renderSourceInventory(){const host=document.getElementById('sourceInventory');if(!host)return;if(!state.sources.length){host.innerHTML='<div class="empty"><b>No sources yet.</b>Upload the first CSV above.</div>';return}host.innerHTML='<div class="actions" style="justify-content:flex-end;margin-bottom:9px"><button class="btn small danger" onclick="clearCsvSources()">Clear CSV Sources</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Source</th><th>Rows</th><th>Headers</th><th>Raw Data</th><th>Uploaded</th><th></th></tr></thead><tbody>'+state.sources.map(s=>`<tr><td><b>${esc(s.name)}</b></td><td>${fmt(s.rowCount)}</td><td>${s.headers.length}</td><td><span id="sourceHealth_${esc(s.id)}" class="badge blue">Checking…</span></td><td>${esc(new Date(s.uploadedAt).toLocaleString())}</td><td><div class="actions"><button class="btn small" onclick="selectSource('${esc(s.id)}',1)">Analyze</button><button class="btn small danger" onclick="deleteSource('${esc(s.id)}')">Delete</button></div></td></tr>`).join('')+'</tbody></table></div>';refreshSourceHealth()}
function selectSource(id,nextStep){state.currentSourceId=id;saveState();showStep(nextStep)}
function renderSourcePicker(hostId,onStep){const host=document.getElementById(hostId);if(!host)return;host.innerHTML=state.sources.map(s=>`<button class="source-chip ${s.id===currentSource()?.id?'active':''}" onclick="selectSource('${esc(s.id)}',${onStep})">${esc(s.name)}</button>`).join('')}
function renderProfile(){renderSourcePicker('profileSourcePicker',1);const host=document.getElementById('profileContent'),s=currentSource();if(!s){host.innerHTML='<div class="empty"><b>No source selected.</b>Upload a CSV in Step 0.</div>';return}const p=s.profile;host.innerHTML=`<div class="grid cards"><div class="card profile-card"><b>Rows</b><div class="big">${fmt(p.rowCount)}</div></div><div class="card profile-card"><b>Headers</b><div class="big">${p.columnCount}</div></div><div class="card profile-card"><b>Duplicate Rows</b><div class="big">${fmt(p.duplicateRows)}</div></div><div class="card profile-card"><b>Source</b><div class="big" style="font-size:16px">${esc(s.name)}</div><div class="sub">${esc(new Date(s.uploadedAt).toLocaleString())}</div></div></div><section class="panel" style="margin-top:14px"><h3>Header Profile</h3><div class="table-wrap"><table class="table"><thead><tr><th>Header</th><th>Detected Type</th><th>Sample Values</th><th>Nulls</th><th>Null %</th><th>Distinct</th><th>Distinct %</th><th>Min</th><th>Max</th></tr></thead><tbody>${s.headers.map(h=>{const x=p.fields[h];return `<tr><td><b>${esc(h)}</b></td><td>${esc(x.dataType)}</td><td>${esc(x.sample.join(' | '))}</td><td>${fmt(x.nullCount)}</td><td>${pct(x.nullPct)}</td><td>${fmt(x.distinctCount)}</td><td>${pct(x.distinctPct)}</td><td class="mono">${esc(x.min)}</td><td class="mono">${esc(x.max)}</td></tr>`}).join('')}</tbody></table></div></section>`}

function renderFieldStaging(){renderSourcePicker('fieldSourcePicker',2);const host=document.getElementById('fieldStageContent'),s=currentSource();if(!s){host.innerHTML='<div class="empty"><b>No source selected.</b></div>';return}const roles=['Unknown','Identifier','Relationship Key','Dimension','Measure','Date/Time','Flag','Descriptive Text'];host.innerHTML=`<div class="actions" style="margin-bottom:10px"><button class="btn small" onclick="setAllFieldStatus('Promoted')">Promote All</button><button class="btn small" onclick="setAllFieldStatus('Held')">Hold All</button><button class="btn small" onclick="setAllFieldStatus('Ignored')">Ignore All</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Header</th><th>Type</th><th>Sample</th><th>Null %</th><th>Distinct %</th><th>What Does This Field Mean?</th><th>Structural Role</th><th>Status</th></tr></thead><tbody>${s.headers.map(h=>{const f=state.fields[s.id+'::'+h],p=s.profile.fields[h];return `<tr><td><b>${esc(h)}</b></td><td>${esc(p.dataType)}</td><td>${esc(p.sample.join(' | '))}</td><td>${pct(p.nullPct)}</td><td>${pct(p.distinctPct)}</td><td><input value="${esc(f.meaning)}" placeholder="User-defined meaning" onchange="updateField('${esc(f.id)}','meaning',this.value)"></td><td><select onchange="updateField('${esc(f.id)}','role',this.value)">${roles.map(r=>`<option ${r===f.role?'selected':''}>${esc(r)}</option>`).join('')}</select></td><td><select class="stage-status" onchange="updateField('${esc(f.id)}','status',this.value)">${['Unreviewed','Promoted','Held','Ignored'].map(x=>`<option ${x===f.status?'selected':''}>${x}</option>`).join('')}</select></td></tr>`}).join('')}</tbody></table></div>`}
function updateField(id,key,value){if(!state.fields[id])return;state.fields[id][key]=value;saveState();if(activeStep===3)renderRelationships();if(activeStep===4)renderConcepts();if(activeStep===5)renderMetricBuilder();if(activeStep===7)renderDashboardBuilder()}
function setAllFieldStatus(status){const s=currentSource();if(!s)return;s.headers.forEach(h=>state.fields[s.id+'::'+h].status=status);saveState();renderFieldStaging()}
function promotedFields(sourceId=null){return Object.values(state.fields).filter(f=>f.status==='Promoted'&&(!sourceId||f.sourceId===sourceId))}
function fieldLabel(f){const s=sourceById(f.sourceId);return `${s?.name||f.sourceId} · ${f.header}`}
function allFieldOptions(selected='',sourceId=null,onlyPromoted=true){const fields=Object.values(state.fields).filter(f=>(!sourceId||f.sourceId===sourceId)&&(!onlyPromoted||f.status==='Promoted'));return '<option value="">Select field</option>'+fields.map(f=>`<option value="${esc(f.id)}" ${f.id===selected?'selected':''}>${esc(fieldLabel(f))}</option>`).join('')}

function renderRelationships(){const keyHost=document.getElementById('keyCandidates'),relHost=document.getElementById('relationshipList'),left=document.getElementById('relLeft'),right=document.getElementById('relRight');const promoted=promotedFields();if(!promoted.length){keyHost.innerHTML='<div class="empty"><b>No promoted fields.</b>Promote fields in Step 2 first.</div>'}else{keyHost.innerHTML='<div class="relationship-candidates">'+promoted.map(f=>{const s=sourceById(f.sourceId),p=s.profile.fields[f.header],candidate=p.nullCount===0&&p.distinctPct>=95;return `<div class="candidate"><div class="actions" style="justify-content:space-between"><strong>${esc(f.header)}</strong><span class="badge ${candidate?'good':'warn'}">${candidate?'High uniqueness':'Review'}</span></div><div class="meta">${esc(s.name)} · ${pct(p.distinctPct)} distinct · ${fmt(p.nullCount)} nulls</div><div class="actions" style="margin-top:8px"><button class="btn small ${f.isPrimaryKey?'primary':''}" onclick="toggleKey('${esc(f.id)}','primary')">${f.isPrimaryKey?'Primary Key ✓':'Set Primary Key'}</button><button class="btn small ${f.isRelationshipKey?'primary':''}" onclick="toggleKey('${esc(f.id)}','relationship')">${f.isRelationshipKey?'Relationship Key ✓':'Mark Relationship Key'}</button></div></div>`}).join('')+'</div>'}left.innerHTML=allFieldOptions('',null,true);right.innerHTML=allFieldOptions('',null,true);if(!state.relationships.length)relHost.innerHTML='<div class="empty"><b>No confirmed relationships.</b>With one source, you may only need a primary key. Add source-to-source joins as more CSVs arrive.</div>';else relHost.innerHTML='<div class="table-wrap"><table class="table"><thead><tr><th>Left</th><th>Relationship</th><th>Right</th><th></th></tr></thead><tbody>'+state.relationships.map(r=>`<tr><td>${esc(fieldLabel(fieldById(r.leftFieldId)))}</td><td>${esc(r.type)}</td><td>${esc(fieldLabel(fieldById(r.rightFieldId)))}</td><td><button class="btn small danger" onclick="removeRelationship('${esc(r.id)}')">Remove</button></td></tr>`).join('')+'</tbody></table></div>'}
function toggleKey(id,type){const f=fieldById(id);if(!f)return;if(type==='primary'){Object.values(state.fields).filter(x=>x.sourceId===f.sourceId).forEach(x=>x.isPrimaryKey=false);f.isPrimaryKey=!f.isPrimaryKey}else f.isRelationshipKey=!f.isRelationshipKey;saveState();renderRelationships()}
function addRelationship(){const l=document.getElementById('relLeft').value,r=document.getElementById('relRight').value,t=document.getElementById('relType').value;if(!l||!r||l===r)return alert('Choose two different fields.');if(state.relationships.some(x=>(x.leftFieldId===l&&x.rightFieldId===r)||(x.leftFieldId===r&&x.rightFieldId===l)))return alert('That field relationship is already registered.');state.relationships.push({id:'rel_'+Date.now().toString(36),leftFieldId:l,rightFieldId:r,type:t,createdAt:new Date().toISOString()});state.fields[l].isRelationshipKey=true;state.fields[r].isRelationshipKey=true;saveState();renderRelationships()}
function removeRelationship(id){state.relationships=state.relationships.filter(r=>r.id!==id);saveState();renderRelationships()}

