.source-list{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.source-chip{background:#fff;border:1px solid #cfd6e4;border-radius:7px;padding:7px 9px;cursor:pointer;font-size:11px}.source-chip.active{background:#eef5ff;color:var(--blue);border-color:#9fb7df;font-weight:700}
