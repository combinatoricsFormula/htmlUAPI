function approveMetric(id){const m=metricById(id);if(!m?.validation||m.validation.error)return;m.status='Approved';saveState();renderValidation()}
function renderValidation(){const host=document.getElementById('validationContent');if(!state.metrics.length){host.innerHTML='<div class="empty"><b>No metrics to validate.</b>Create draft metrics in Step 5.</div>';return}host.innerHTML=state.metrics.map(m=>{const v=m.validation;return `<div class="validation-card"><div class="actions" style="justify-content:space-between"><h4>${esc(m.name)}</h4><span class="badge ${m.status==='Approved'?'good':m.status==='Validated'?'blue':'warn'}">${esc(m.status)}</span></div><div class="mono">${esc(m.formulaPreview||'')}</div>${v?.error?`<div class="notice warn" style="margin-top:8px">${esc(v.error)}</div>`:v?`<div class="validation-result">${Number.isFinite(v.value)?fmt(v.value,4):'—'}</div><div class="validation-meta">Population: ${fmt(v.totalRows)} · Matched: ${fmt(v.matchedRows)} · Invalid values: ${fmt(v.invalidCount)}${v.warnings?.length?'<br>'+v.warnings.map(esc).join('<br>'):''}</div>`:'<div class="muted" style="margin-top:8px;font-size:10px">Not yet executed.</div>'}<div class="actions" style="margin-top:9px"><button class="btn small" onclick="validateMetric('${esc(m.id)}')">Validate</button><button class="btn small primary" onclick="approveMetric('${esc(m.id)}')" ${!v||v.error?'disabled':''}>Approve</button></div></div>`}).join('')}

function ensureDashboardShape(db){
  if(!db)return null;
  if(!Array.isArray(db.components))db.components=[];
  if(!Array.isArray(db.filters))db.filters=[];
  if(!Array.isArray(db.sections))db.sections=[];
  db.components.forEach(c=>{
    if(!c.visual)c.visual='KPI';
    if(!c.span)c.span=4;
    if(!Number.isFinite(Number(c.minHeight)))c.minHeight=0;
    if(!c.threshold)c.threshold={enabled:false,direction:'higher',good:'',watch:''};
    if(!c.visualMap)c.visualMap={xFieldId:'',yMetricId:c.metricId||'',seriesFieldId:''};
    if(!c.visualMap.yMetricId)c.visualMap.yMetricId=c.metricId||'';
  });
  const assigned=new Set(db.sections.flatMap(s=>Array.isArray(s.componentIds)?s.componentIds:[]));
  const unassigned=db.components.filter(c=>!assigned.has(c.id)).map(c=>c.id);
  if(unassigned.length){let d=db.sections.find(s=>s.id==='section_default');if(!d){d={id:'section_default',orientation:'horizontal',componentIds:[]};db.sections.unshift(d)}d.componentIds.push(...unassigned)}
  db.sections.forEach(s=>{if(!Array.isArray(s.componentIds))s.componentIds=[];if(!['horizontal','vertical'].includes(s.orientation))s.orientation='horizontal';s.componentIds=s.componentIds.filter(id=>db.components.some(c=>c.id===id))});
  return db
}
function renderDashboardBuilder(){
  const sel=document.getElementById('dashboardSelect'),metricPalette=document.getElementById('dashboardMetricPalette'),fieldPalette=document.getElementById('dashboardFieldPalette');
  sel.innerHTML='<option value="">None</option>'+state.dashboards.map(d=>`<option value="${esc(d.id)}" ${d.id===state.currentDashboardId?'selected':''}>${esc(d.name)}</option>`).join('');
  const approved=state.metrics.filter(m=>m.status==='Approved');
  metricPalette.innerHTML=approved.length?approved.map(m=>`<div class="palette-item" draggable="true" ondragstart="dragMetric(event,'${esc(m.id)}')"><b>${esc(m.name)}</b><small>${esc(m.formulaPreview||'')}</small></div>`).join(''):'<div class="empty"><b>No approved metrics.</b>Validate and approve metrics in Step 6.</div>';
  const promoted=promotedFields();
  fieldPalette.innerHTML=promoted.length?promoted.map(f=>{const src=sourceById(f.sourceId);return `<div class="filter-field-chip" draggable="true" ondragstart="dragDashboardField(event,'${esc(f.id)}')" ondblclick="addDashboardFilter('${esc(f.id)}')" title="Drag to filter area or double-click"><b>${esc(f.header)}</b><small>${esc(src?.name||'')} · ${esc(f.dataType)} · ${esc(f.role||'Unknown')}</small></div>`}).join(''):'<div class="empty" style="width:100%"><b>No promoted fields.</b>Promote fields in Step 2 to make them available as dashboard filters.</div>';
  renderDashboardFilters();renderDashboardCanvas();
}
