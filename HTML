function metricDependencyClosure(id){const ids=new Set([id]);let changed=true;while(changed){changed=false;for(const m of state.metrics){if(ids.has(m.id))continue;if(m.mode==='derived'&&(ids.has(m.derivedLeftMetricId)||ids.has(m.derivedRightMetricId))){ids.add(m.id);changed=true}}}return ids}
function deleteMetric(id){const m=metricById(id);if(!m)return;const ids=metricDependencyClosure(id),dependent=Math.max(0,ids.size-1);let cardCount=0;for(const d of state.dashboards)cardCount+=(d.components||[]).filter(c=>ids.has(c.metricId)||ids.has(c.visualMap?.yMetricId)).length;if((dependent||cardCount)&&!confirm(`Delete ${m.name}? This also removes ${dependent} derived metric(s) that depend on it and ${cardCount} dashboard component(s).`))return;state.metrics=state.metrics.filter(x=>!ids.has(x.id));for(const d of state.dashboards){d.components=(d.components||[]).filter(c=>!ids.has(c.metricId)&&!ids.has(c.visualMap?.yMetricId));const valid=new Set(d.components.map(c=>c.id));(d.sections||[]).forEach(sec=>sec.componentIds=(sec.componentIds||[]).filter(cid=>valid.has(cid)))}saveState();renderMetricBuilder()}

function compareValues(raw,op,v1,v2){const s=String(raw??''),t=s.trim(),a=String(v1??''),b=String(v2??'');const n=Number(t.replace(/[$,%]/g,'')),n1=Number(a.replace(/[$,%]/g,'')),n2=Number(b.replace(/[$,%]/g,''));const d=Date.parse(t),d1=Date.parse(a),d2=Date.parse(b);switch(op){case'=':return t.toLowerCase()===a.trim().toLowerCase();case'!=':return t.toLowerCase()!==a.trim().toLowerCase();case'>':return Number.isFinite(n)&&Number.isFinite(n1)?n>n1:t>a;case'>=':return Number.isFinite(n)&&Number.isFinite(n1)?n>=n1:t>=a;case'<':return Number.isFinite(n)&&Number.isFinite(n1)?n<n1:t<a;case'<=':return Number.isFinite(n)&&Number.isFinite(n1)?n<=n1:t<=a;case'IN':return a.split(',').map(x=>x.trim().toLowerCase()).includes(t.toLowerCase());case'NOT IN':return !a.split(',').map(x=>x.trim().toLowerCase()).includes(t.toLowerCase());case'CONTAINS':return t.toLowerCase().includes(a.toLowerCase());case'NOT CONTAINS':return !t.toLowerCase().includes(a.toLowerCase());case'STARTS WITH':return t.toLowerCase().startsWith(a.toLowerCase());case'ENDS WITH':return t.toLowerCase().endsWith(a.toLowerCase());case'BETWEEN':return Number.isFinite(n)&&Number.isFinite(n1)&&Number.isFinite(n2)?n>=Math.min(n1,n2)&&n<=Math.max(n1,n2):(t>=a&&t<=b);case'IS NULL':return isBlank(raw);case'IS NOT NULL':return !isBlank(raw);case'IS TRUE':return truthyValue(raw);case'IS FALSE':return falseyValue(raw);case'BEFORE':return Number.isFinite(d)&&Number.isFinite(d1)&&d<d1;case'AFTER':return Number.isFinite(d)&&Number.isFinite(d1)&&d>d1;case'ON OR BEFORE':return Number.isFinite(d)&&Number.isFinite(d1)&&d<=d1;case'ON OR AFTER':return Number.isFinite(d)&&Number.isFinite(d1)&&d>=d1;default:return false}}
function rowMatches(row,filters){if(!filters?.length)return true;let result=null;for(let i=0;i<filters.length;i++){const f=filters[i],field=fieldById(f.fieldId),hit=field?compareValues(row[field.header],f.op,f.value,f.value2):false;if(i===0)result=hit;else result=f.conjunction==='OR'?(result||hit):(result&&hit)}return !!result}
function median(nums){if(!nums.length)return NaN;const a=[...nums].sort((x,y)=>x-y),m=Math.floor(a.length/2);return a.length%2?a[m]:(a[m-1]+a[m])/2}
function percentileValue(nums,p){if(!nums.length)return NaN;const a=[...nums].sort((x,y)=>x-y),idx=(Math.max(0,Math.min(100,p))/100)*(a.length-1),lo=Math.floor(idx),hi=Math.ceil(idx);return lo===hi?a[lo]:a[lo]+(a[hi]-a[lo])*(idx-lo)}
async function evaluateMetric(metric,stack=[],runtimeFilters=[]){if(stack.includes(metric.id))throw new Error('Derived metric cycle detected.');if(metric.mode==='derived'){const l=metricById(metric.derivedLeftMetricId),r=metricById(metric.derivedRightMetricId);if(!l||!r)throw new Error('Derived metric references a missing metric.');const lv=(await evaluateMetric(l,[...stack,metric.id],runtimeFilters)).value,rv=(await evaluateMetric(r,[...stack,metric.id],runtimeFilters)).value;let v;if(metric.derivedOp==='+')v=lv+rv;else if(metric.derivedOp==='-')v=lv-rv;else if(metric.derivedOp==='*')v=lv*rv;else v=rv===0?NaN:lv/rv;v*=Number(metric.derivedScale||1);return{value:v,totalRows:0,matchedRows:0,invalidCount:0,series:null,warnings:[],unappliedFilters:[]}}const rows=await getRows(metric.sourceId),dashboardFiltered=await applyDashboardFiltersToRows(metric.sourceId,rows,runtimeFilters),matched=dashboardFiltered.rows.filter(r=>rowMatches(r,metric.filters||[]));let value=NaN,invalidCount=0;const groupField=fieldById(metric.groupByFieldId);const calcRows=async rs=>{if(metric.mode==='datediff'){const a=fieldById(metric.dateStartFieldId),b=fieldById(metric.dateEndFieldId),factor={seconds:1000,minutes:60000,hours:3600000,days:86400000}[metric.dateUnit]||3600000;const vals=[];rs.forEach(r=>{const x=Date.parse(r[a.header]),y=Date.parse(r[b.header]);if(Number.isFinite(x)&&Number.isFinite(y))vals.push((y-x)/factor);else invalidCount++});if(!vals.length)return NaN;if(metric.dateAgg==='SUM')return vals.reduce((x,y)=>x+y,0);if(metric.dateAgg==='MIN')return Math.min(...vals);if(metric.dateAgg==='MAX')return Math.max(...vals);if(metric.dateAgg==='MEDIAN')return median(vals);return vals.reduce((x,y)=>x+y,0)/vals.length}const agg=metric.aggregation,field=fieldById(metric.fieldId);if(agg==='COUNT_ROWS')return rs.length;const raw=rs.map(r=>r[field.header]).filter(v=>!isBlank(v));if(agg==='COUNT')return raw.length;if(agg==='COUNT_DISTINCT')return new Set(raw.map(String)).size;const nums=raw.map(v=>Number(String(v).replace(/[$,%]/g,''))).filter(x=>{if(Number.isFinite(x))return true;invalidCount++;return false});if(!nums.length)return NaN;if(agg==='SUM')return nums.reduce((a,b)=>a+b,0);if(agg==='AVG')return nums.reduce((a,b)=>a+b,0)/nums.length;if(agg==='MIN')return Math.min(...nums);if(agg==='MAX')return Math.max(...nums);if(agg==='MEDIAN')return median(nums);if(agg==='PERCENTILE')return percentileValue(nums,metric.percentile);return NaN};value=await calcRows(matched);let series=null;if(groupField){const groups=new Map();matched.forEach(r=>{const k=String(r[groupField.header]??'').trim()||'(blank)';if(!groups.has(k))groups.set(k,[]);groups.get(k).push(r)});series=[];for(const [label,rs] of groups){const before=invalidCount;const v=await calcRows(rs);series.push({label,value:v,count:rs.length,invalid:invalidCount-before})}series.sort((a,b)=>(Number(b.value)||0)-(Number(a.value)||0))}const warnings=[];if(!matched.length)warnings.push('No rows matched the filters.');if(invalidCount)warnings.push(`${invalidCount} value(s) could not be used by the calculation.`);return{value,totalRows:rows.length,matchedRows:matched.length,invalidCount,series,warnings,unappliedFilters:dashboardFiltered.unapplied}}

async function validateMetric(id){const m=metricById(id);if(!m)return;try{const result=await evaluateMetric(m);m.validation={...result,validatedAt:new Date().toISOString()};m.status='Validated';saveState();renderValidation()}catch(err){m.validation={error:err?.message||String(err),validatedAt:new Date().toISOString()};m.status='Draft';saveState();renderValidation()}}
