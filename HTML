/* =====================================================================
   GOLDEN BASELINE VISUAL INTEGRATION — STEP 7 + WORKING DASHBOARD ONLY
   Functional workflow, state, calculations, Steps 0–6 and data logic are
   intentionally untouched. These rules map the Golden Baseline visual
   language onto the from-scratch dashboard builder and preview.
   ===================================================================== */
#step7{background:var(--bg)}
#step7 .page{max-width:none;padding:0 2px}
#step7 .page-head{margin-bottom:16px;padding:2px 2px 0}
#step7 .page-head h2{color:var(--blue);font-size:22px;font-weight:700}
#step7 .page-head p{color:#475467;max-width:1100px}
#step7 .panel{
  background:#fff;border:0;border-radius:12px;padding:20px;
  box-shadow:0 2px 8px rgba(0,0,0,.08);margin-bottom:18px
}
#step7 .panel h3{color:var(--blue);font-size:15px}
#step7 .builder{
  grid-template-columns:minmax(300px,.78fr) minmax(600px,2.22fr);
  gap:18px;align-items:start
}
#step7 .palette{
  border:1px solid #dfe5ef;border-radius:12px;background:#fff;padding:15px;
  box-shadow:0 2px 8px rgba(0,0,0,.08);max-height:72vh;scrollbar-gutter:stable
}
#step7 .canvas{
  min-height:68vh;border:1px solid #dfe5ef;border-radius:12px;padding:15px;
  background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.08)
}
#step7 .canvas.drag-over{outline:2px dashed var(--blue);outline-offset:2px;background:#f8fbff}
#step7 .dashboard-builder-toolbar{margin-bottom:12px}
#step7 .builder-help{font-size:11px;line-height:1.5;color:#667085}
#step7 .palette-section-title{
  margin:14px 0 7px;font-size:11px;font-weight:800;text-transform:uppercase;
  letter-spacing:.06em;color:#667085
}

/* Promoted fields become Golden-Baseline-style filter cards. */
#step7 .promoted-filter-palette{gap:10px}
#step7 .filter-field-chip{
  min-width:180px;max-width:280px;background:#fff;border:1px solid #dfe5ef;
  border-radius:10px;padding:10px 11px;box-shadow:0 1px 3px rgba(16,24,40,.05);
  transition:.15s
}
#step7 .filter-field-chip:hover{
  background:var(--soft);border-color:#bfd0ea;box-shadow:0 4px 12px rgba(16,24,40,.08)
}
#step7 .filter-field-chip b{font-size:12px;color:#23395d}
#step7 .filter-field-chip small{font-size:10px;line-height:1.4}
#step7 .filter-drop-zone{
  margin-top:12px;min-height:86px;border:2px dashed #c6d2e7;border-radius:10px;
  padding:12px;background:#f8fafc
}
#step7 .filter-drop-zone.drag-over{border-color:var(--blue);background:#eef5ff}
#step7 .dashboard-filter{
  min-width:210px;max-width:330px;border:1px solid #dfe5ef;border-radius:10px;
  padding:10px;background:#fff;box-shadow:0 1px 3px rgba(16,24,40,.05)
}
#step7 .dashboard-filter .filter-title{font-size:11px;color:#23395d}

/* Golden Baseline button rhythm, limited to Step 7 and the dashboard view. */
#step7 .btn,.dashboard-preview-overlay .btn{
  border-radius:6px;padding:9px 13px;transition:.2s;font-weight:650
}
#step7 .btn.primary,.dashboard-preview-overlay .btn.primary{
  background:var(--blue);color:#fff;border-color:var(--blue)
}
#step7 .btn.primary:hover,.dashboard-preview-overlay .btn.primary:hover{
  background:var(--blue2);color:#fff
}

/* Layout structures: elegant, obvious horizontal/vertical containers. */
#step7 .layout-structure-palette{gap:9px}
#step7 .layout-structure-item{
  border:1px dashed #9fb7df;background:#f8fbff;border-radius:10px;padding:11px 9px;
  color:#23395d;font-size:11px;font-weight:800;box-shadow:inset 0 0 0 1px rgba(11,61,145,.02)
}
#step7 .layout-structure-item:hover{background:#eef5ff;border-color:var(--blue)}
#step7 .dashboard-layout{gap:15px}
#step7 .dash-section,
.dashboard-preview-overlay .dash-section{
  border:1px solid #dfe5ef;border-radius:12px;background:#f8fafc;padding:13px;
  min-height:118px;box-shadow:inset 0 1px 0 rgba(255,255,255,.75);transition:.15s
}
#step7 .dash-section:hover{border-color:#b9c8dc}
#step7 .dash-section.drag-over{outline:2px dashed var(--blue);outline-offset:2px;background:#eef5ff}
#step7 .dash-section-title,.dashboard-preview-overlay .dash-section-title{
  font-size:11px;font-weight:800;color:#475467;letter-spacing:.06em
}
#step7 .dash-section-empty{
  min-height:84px;border:1px dashed #c6d2e7;border-radius:8px;background:#fff;color:#98a2b3
}

/* Golden Baseline KPI/card system. */
#step7 .dash-card,
.dashboard-preview-overlay .dash-card{
  position:relative;background:#fff;border:0;border-top:4px solid #64748b;
  border-radius:12px;padding:15px;box-shadow:0 2px 6px rgba(0,0,0,.10);
  transition:box-shadow .15s,transform .15s,outline-color .15s;outline:1px solid transparent;
  overflow:visible
}
#step7 .dash-card:hover,#step7 .dash-card:focus-within,#step7 .dash-card.intel-open,
.dashboard-preview-overlay .dash-card:hover,.dashboard-preview-overlay .dash-card:focus-within,.dashboard-preview-overlay .dash-card.intel-open{
  transform:none;box-shadow:0 10px 28px rgba(0,0,0,.14);outline-color:#d9e3f0
}
#step7 .dash-card h4,.dashboard-preview-overlay .dash-card h4{font-size:13px;color:#666;font-weight:700}
#step7 .dash-value,.dashboard-preview-overlay .dash-value{
  margin-top:5px;font-size:27px;font-weight:700;color:#23395d
}
#step7 .dash-card.status-good,.dashboard-preview-overlay .dash-card.status-good{border-top-color:#16a34a}
#step7 .dash-card.status-watch,.dashboard-preview-overlay .dash-card.status-watch{border-top-color:#f59e0b}
#step7 .dash-card.status-critical,.dashboard-preview-overlay .dash-card.status-critical{border-top-color:#dc2626}
#step7 .dash-card.status-neutral,.dashboard-preview-overlay .dash-card.status-neutral{border-top-color:#64748b}
#step7 .dash-card.status-good .dash-value,.dashboard-preview-overlay .dash-card.status-good .dash-value{color:#15803d}
#step7 .dash-card.status-watch .dash-value,.dashboard-preview-overlay .dash-card.status-watch .dash-value{color:#b45309}
#step7 .dash-card.status-critical .dash-value,.dashboard-preview-overlay .dash-card.status-critical .dash-value{color:#b42318}
#step7 .dash-card-status,.dashboard-preview-overlay .dash-card-status{
  margin-top:1px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.04em
}

/* Intelligence Summary = Golden Baseline hover/focus evidence card. */
#step7 .intel-summary,
.dashboard-preview-overlay .intel-summary{
  display:none;position:fixed;top:145px;right:25px;left:auto;z-index:99999;
  width:600px;max-width:calc(100vw - 50px);max-height:82vh;overflow-y:auto;
  overscroll-behavior:contain;scrollbar-gutter:stable;background:#fff;
  border:1px solid #d9d9d9;border-radius:10px;box-shadow:0 15px 35px rgba(0,0,0,.18);
  padding:15px
}
#step7 .dash-card:hover>.intel-summary,#step7 .dash-card:focus-within>.intel-summary,#step7 .dash-card.intel-open>.intel-summary,
.dashboard-preview-overlay .dash-card:hover>.intel-summary,.dashboard-preview-overlay .dash-card:focus-within>.intel-summary,.dashboard-preview-overlay .dash-card.intel-open>.intel-summary{display:block}
#step7 .intel-summary h5,.dashboard-preview-overlay .intel-summary h5{
  margin:0 0 8px;color:var(--blue);font-size:16px
}
#step7 .intel-summary-grid,.dashboard-preview-overlay .intel-summary-grid{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px
}
#step7 .intel-item,.dashboard-preview-overlay .intel-item{
  background:#fff;border:0;border-bottom:1px solid #eee;border-radius:0;padding:7px 2px
}
#step7 .intel-item b,.dashboard-preview-overlay .intel-item b{
  font-size:9px;color:#667085;text-transform:uppercase;letter-spacing:.04em;margin-bottom:3px
}
#step7 .intel-item div,.dashboard-preview-overlay .intel-item div{font-size:11px;line-height:1.45;color:#344054}
#step7 .intel-wide,.dashboard-preview-overlay .intel-wide{grid-column:1/-1}
#step7 .intel-summary::after,.dashboard-preview-overlay .intel-summary::after{
  content:"Hover/focus intelligence";display:block;margin-top:10px;padding:10px;
  background:#f0f6ff;border-left:4px solid var(--blue);border-radius:6px;
  color:#475467;font-size:10px;line-height:1.4
}

/* Threshold controls inherit the baseline Good / Watch / Critical visual language. */
#step7 .threshold-editor,.dashboard-preview-overlay .threshold-editor{
  margin-top:10px;background:#f8fafc;border:1px solid #e4e7ec;border-radius:8px;padding:10px
}
#step7 .status-good .status-dot,.dashboard-preview-overlay .status-good .status-dot{background:#16a34a}
#step7 .status-watch .status-dot,.dashboard-preview-overlay .status-watch .status-dot{background:#f59e0b}
#step7 .status-critical .status-dot,.dashboard-preview-overlay .status-critical .status-dot{background:#dc2626}

/* Golden Baseline full-dashboard presentation. */
.dashboard-preview-overlay{background:var(--bg)}
.dashboard-preview-shell{max-width:none;margin:0;padding:0 20px 20px}
.dashboard-preview-head{
  position:sticky;top:0;z-index:100;background:var(--blue);color:#fff;border:0;border-radius:0;
  box-shadow:0 2px 6px rgba(0,0,0,.15);padding:15px 25px;margin:0 -20px 18px
}
.dashboard-preview-head .eyebrow{color:rgba(255,255,255,.75)}
.dashboard-preview-head h2{color:#fff!important;font-size:24px!important;font-weight:600!important}
.dashboard-preview-head .btn{background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.28)}
.dashboard-preview-head .btn:hover{background:rgba(255,255,255,.20);color:#fff;border-color:rgba(255,255,255,.40)}
.dashboard-preview-head .btn.primary{background:#fff;color:var(--blue);border-color:#fff}
.dashboard-preview-head .btn.primary:hover{background:#eef5ff;color:var(--blue)}
.dashboard-preview-body{
  background:transparent;border:0;border-radius:0;box-shadow:none;padding:0;max-width:1700px;margin:0 auto
}
.dashboard-preview-filters{
  background:#fff;border:1px solid #dfe5ef;border-radius:12px;padding:15px;margin-bottom:18px;
  box-shadow:0 2px 8px rgba(0,0,0,.08)
}
.dashboard-preview-grid{display:block}
.dashboard-preview-grid .dashboard-layout{gap:18px}
.dashboard-preview-grid .dash-section{background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.dashboard-preview-grid .dash-card{cursor:default}

/* Golden baseline scrollbar and containment behavior. */
#step7 ::-webkit-scrollbar,.dashboard-preview-overlay ::-webkit-scrollbar{width:10px;height:10px}
#step7 ::-webkit-scrollbar-thumb,.dashboard-preview-overlay ::-webkit-scrollbar-thumb{background:#c6d2e7;border-radius:20px}
#step7 ::-webkit-scrollbar-track,.dashboard-preview-overlay ::-webkit-scrollbar-track{background:#f8f8f8}
#step7 .builder,#step7 .palette,#step7 .canvas,#step7 .dash-section,#step7 .dash-card,
.dashboard-preview-overlay .dash-section,.dashboard-preview-overlay .dash-card{min-width:0}

@media(max-width:1100px){
  #step7 .builder{grid-template-columns:1fr}
  #step7 .palette{max-height:none}
}
@media(max-width:950px){
  #step7 .intel-summary,.dashboard-preview-overlay .intel-summary{display:none!important}
}
@media(max-width:700px){
  #step7 .panel{padding:15px}
  .dashboard-preview-shell{padding:0 12px 12px}
  .dashboard-preview-head{margin:0 -12px 14px;padding:13px 15px}
}


/* Golden Baseline review: Step 7 visualization shelves + data intelligence only. */
#step7 .visual-shelves{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin:9px 0 3px}
#step7 .visual-role-zone{min-height:56px;border:1.5px dashed #b8c4d6;border-radius:8px;background:#f8fafc;padding:7px 8px;display:flex;flex-direction:column;justify-content:center;gap:3px;transition:.15s;position:relative}
#step7 .visual-role-zone:hover{border-color:#93aacf;background:#f4f8ff}
#step7 .visual-role-zone.drag-over{border-color:var(--blue);background:#eef5ff;outline:2px solid rgba(11,61,145,.10)}
#step7 .visual-role-zone b{font-size:9px;text-transform:uppercase;letter-spacing:.055em;color:#667085}
#step7 .visual-role-zone .role-value{font-size:11px;font-weight:700;color:#23395d;overflow-wrap:anywhere}
#step7 .visual-role-zone .role-hint{font-size:9px;color:#98a2b3;line-height:1.25}
#step7 .visual-role-zone .role-clear{position:absolute;top:4px;right:4px;width:20px;height:20px;border:0;background:transparent;color:#98a2b3;padding:0;border-radius:4px;font-size:13px}
#step7 .visual-role-zone .role-clear:hover{background:#eef2f6;color:#b42318}
#step7 .visual-map-note{font-size:9px;color:#667085;line-height:1.35;margin:3px 0 7px}
#step7 .intel-summary .intel-evidence,.dashboard-preview-overlay .intel-summary .intel-evidence{background:#f8fafc;border:1px solid #e4e7ec;border-radius:7px;padding:8px 9px;font-size:11px;line-height:1.45;color:#344054}
#step7 .intel-summary .intel-observations,.dashboard-preview-overlay .intel-summary .intel-observations{margin:7px 0 0 16px;font-size:11px;line-height:1.45;color:#344054}
#step7 .intel-summary .intel-observations li,.dashboard-preview-overlay .intel-summary .intel-observations li{margin:4px 0}
#step7 .intel-summary .intel-data-note,.dashboard-preview-overlay .intel-summary .intel-data-note{font-size:10px;line-height:1.4;color:#667085;margin-top:7px}
@media(max-width:900px){#step7 .visual-shelves{grid-template-columns:1fr 1fr}}

</style>
