.workflow button:hover{background:#f8fbff;color:var(--blue);border-color:#abc0df}.workflow button.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.shell{flex:1 1 auto;min-height:0;overflow:hidden}.step{display:none;height:100%;overflow:auto;padding:18px}.step.active{display:block}
.page{max-width:1600px;margin:0 auto}.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}.page-head h2{margin:0;color:var(--blue);font-size:22px}.page-head p{margin:5px 0 0;color:var(--muted);line-height:1.5;max-width:980px}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:#667085;margin-bottom:4px}
.panel{background:#fff;border:1px solid #e4e7ec;border-radius:10px;box-shadow:var(--shadow);padding:16px;margin-bottom:14px}.panel h3{margin:0 0 8px;color:#23395d;font-size:15px}.panel p{color:var(--muted);font-size:12px;line-height:1.5}
.grid{display:grid;gap:12px}.grid.cards{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}
