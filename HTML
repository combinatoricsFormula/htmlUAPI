function renderFilterRows(){const host=document.getElementById('filterRows');if(!host)return;const sid=document.getElementById('metricSource')?.value||'';if(!draftFilters.length){host.innerHTML='<div class="muted" style="font-size:10px;margin-top:7px">No filters. The calculation uses all rows in the selected source.</div>';return}host.innerHTML=draftFilters.map((f,i)=>`<div class="filter-row"><div class="field"><label>Join</label><select onchange="updateFilter('${f.id}','conjunction',this.value)" ${i===0?'disabled':''}><option ${f.conjunction==='AND'?'selected':''}>AND</option><option ${f.conjunction==='OR'?'selected':''}>OR</option></select></div><div class="field"><label>Field</label><select onchange="updateFilter('${f.id}','fieldId',this.value)">${allFieldOptions(f.fieldId,sid,true)}</select></div><div class="field"><label>Operator</label><select onchange="updateFilter('${f.id}','op',this.value)">${FILTER_OPS.map(op=>`<option ${op===f.op?'selected':''}>${esc(op)}</option>`).join('')}</select></div><div class="field"><label>Value</label><input value="${esc(f.value)}" placeholder="true, Completed, 100..." oninput="updateFilter('${f.id}','value',this.value,false)"></div><div class="field"><label>Second Value</label><input value="${esc(f.value2)}" placeholder="For BETWEEN" oninput="updateFilter('${f.id}','value2',this.value,false)"></div><button class="btn small danger remove" onclick="removeFilter('${f.id}')">Remove</button></div>`).join('')}
